{
  "uid": "diagramium-service",
  "title": "Service",
  "description": "A per-service RED dashboard. The platform map links here with var-service set to the shape it matched.",
  "tags": ["diagramium", "demo"],
  "editable": true,
  "schemaVersion": 39,
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "refresh": "10s",
  "links": [
    {
      "title": "Platform map",
      "type": "link",
      "url": "/d/diagramium-platform",
      "keepTime": true,
      "icon": "arrow-left"
    },
    {
      "title": "Demo dashboards",
      "type": "dashboards",
      "tags": ["diagramium"],
      "asDropdown": true,
      "includeVars": false,
      "keepTime": true
    }
  ],
  "templating": {
    "list": [
      {
        "name": "service",
        "type": "textbox",
        "label": "Service",
        "query": "checkout",
        "current": {
          "text": "checkout",
          "value": "checkout"
        }
      }
    ]
  },
  "annotations": {
    "list": []
  },
  "panels": [
    {
      "id": 104,
      "type": "text",
      "title": "",
      "gridPos": {
        "h": 4,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "options": {
        "mode": "markdown",
        "content": "## ${service}\nYou clicked **${service}** on the platform map, and landed on its own dashboard with the same time range. In production this is your RED dashboard (rate, errors, duration), filtered by the variable the panel filled in."
      }
    },
    {
      "id": 105,
      "type": "stat",
      "title": "Requests / s",
      "gridPos": {
        "h": 5,
        "w": 8,
        "x": 0,
        "y": 4
      },
      "datasource": {
        "type": "grafana-testdata-datasource",
        "uid": "trlxrdZVk"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-testdata-datasource",
            "uid": "trlxrdZVk"
          },
          "scenarioId": "random_walk",
          "seriesCount": 1,
          "alias": "${service}",
          "startValue": 480,
          "spread": 12,
          "min": 0,
          "seed": 545
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 1000000000
              },
              {
                "color": "red",
                "value": 1000000000
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": ["lastNotNull"]
        },
        "colorMode": "background",
        "graphMode": "area",
        "textMode": "value"
      }
    },
    {
      "id": 106,
      "type": "stat",
      "title": "Error rate",
      "gridPos": {
        "h": 5,
        "w": 8,
        "x": 8,
        "y": 4
      },
      "datasource": {
        "type": "grafana-testdata-datasource",
        "uid": "trlxrdZVk"
      },
      "targets": [
        {
          "refId": "B",
          "datasource": {
            "type": "grafana-testdata-datasource",
            "uid": "trlxrdZVk"
          },
          "scenarioId": "random_walk",
          "seriesCount": 1,
          "alias": "${service}",
          "startValue": 0.8,
          "spread": 0.15,
          "min": 0,
          "max": 10,
          "seed": 66.8
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 1
              },
              {
                "color": "red",
                "value": 5
              }
            ]
          },
          "decimals": 2
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": ["lastNotNull"]
        },
        "colorMode": "background",
        "graphMode": "area",
        "textMode": "value"
      }
    },
    {
      "id": 107,
      "type": "stat",
      "title": "p95 latency",
      "gridPos": {
        "h": 5,
        "w": 8,
        "x": 16,
        "y": 4
      },
      "datasource": {
        "type": "grafana-testdata-datasource",
        "uid": "trlxrdZVk"
      },
      "targets": [
        {
          "refId": "C",
          "datasource": {
            "type": "grafana-testdata-datasource",
            "uid": "trlxrdZVk"
          },
          "scenarioId": "random_walk",
          "seriesCount": 1,
          "alias": "${service}",
          "startValue": 240,
          "spread": 20,
          "min": 0,
          "seed": 307
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 300
              },
              {
                "color": "red",
                "value": 800
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": ["lastNotNull"]
        },
        "colorMode": "background",
        "graphMode": "area",
        "textMode": "value"
      }
    },
    {
      "id": 108,
      "type": "timeseries",
      "title": "${service} — requests / s",
      "gridPos": {
        "h": 10,
        "w": 12,
        "x": 0,
        "y": 9
      },
      "datasource": {
        "type": "grafana-testdata-datasource",
        "uid": "trlxrdZVk"
      },
      "targets": [
        {
          "refId": "D",
          "datasource": {
            "type": "grafana-testdata-datasource",
            "uid": "trlxrdZVk"
          },
          "scenarioId": "random_walk",
          "seriesCount": 1,
          "alias": "${service}",
          "startValue": 480,
          "spread": 12,
          "min": 0,
          "seed": 548
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      }
    },
    {
      "id": 109,
      "type": "timeseries",
      "title": "${service} — p95 latency",
      "gridPos": {
        "h": 10,
        "w": 12,
        "x": 12,
        "y": 9
      },
      "datasource": {
        "type": "grafana-testdata-datasource",
        "uid": "trlxrdZVk"
      },
      "targets": [
        {
          "refId": "E",
          "datasource": {
            "type": "grafana-testdata-datasource",
            "uid": "trlxrdZVk"
          },
          "scenarioId": "random_walk",
          "seriesCount": 1,
          "alias": "${service}",
          "startValue": 240,
          "spread": 20,
          "min": 0,
          "seed": 309
        }
      ],
      "fieldConfig": {
