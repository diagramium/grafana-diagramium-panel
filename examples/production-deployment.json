    "narration": {
      "1": "Traffic comes in from the internet.",
      "2": "The edge firewall only lets 80 and 443 through.",
      "3": "lb-1 spreads requests across the web tier and drops a host that fails its health check.",
      "4": "Three nginx hosts terminate TLS and serve static files\u2026",
      "5": "\u2026so losing one of them costs a third of capacity, not the site.",
      "6": "Each web host forwards API calls to the app tier.",
      "7": "app-1 and app-2 run the API.",
      "8": "Both write to the same primary database.",
      "9": "db-primary takes every write.",
      "10": "db-replica follows it, ready to be promoted.",
      "11": "Every night the replica is backed up to the NAS."
    }
